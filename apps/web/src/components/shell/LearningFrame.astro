---
import LearningFrameReact from "./LearningFrame";
import LearningHeaderControls from "./LearningHeaderControls";
import LearningNavigation from "./LearningNavigation";
import type {
  AcademicTerm,
  CourseInfo,
  LearnerActivity,
  StudentProfile,
} from "../../lib/learning/types";
import type { Locale } from "../../lib/i18n";
import type { AppPath } from "../../lib/routes";

interface Props {
  currentPath: AppPath;
  courses: CourseInfo[];
  profile: StudentProfile;
  term: AcademicTerm;
  activities: LearnerActivity[];
  locale: Locale;
}

const { currentPath, courses, profile, term, activities, locale } = Astro.props;
---

<LearningFrameReact
  {locale}
>
  <Fragment slot="top-nav-end">
    <LearningHeaderControls
      client:load
      transition:persist="learning-header-controls"
      {currentPath}
      {courses}
      {profile}
      {term}
      {activities}
      {locale}
    />
  </Fragment>
  <Fragment slot="side-nav">
    <LearningNavigation
      client:load
      transition:persist="learning-navigation"
      {currentPath}
      {courses}
      {locale}
    />
  </Fragment>
  <slot />
</LearningFrameReact>
