---
import PublicInfoPage from "../../components/pages/PublicInfoPage";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLocale, getMessages } from "../../lib/i18n";

const locale = getLocale(Astro.currentLocale);
const metadata = getMessages(locale).metadata;
---

<BaseLayout title={metadata.privacyTitle} description={metadata.privacyDescription} {locale}>
  <PublicInfoPage kind="privacy" {locale} />
</BaseLayout>
