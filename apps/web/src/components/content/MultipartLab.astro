---
import MultipartLabIsland from "../islands/MultipartLabIsland";
import CourseInteraction from "./CourseInteraction.astro";
import { getMultipartChallenge } from "../../lib/challenges/repository";

interface Props {
  taskId: string;
}

const { taskId } = Astro.props;
const offering = Astro.locals.availableCourseOffering;
if (!offering) throw new Error("Course challenges require an available course offering.");
const challenge = getMultipartChallenge(offering.courseDefinitionKey, taskId);
---

<section class="task-island-anchor" data-task-id={taskId}>
  <CourseInteraction offeringKey={offering.offeringKey}>
    <MultipartLabIsland
      client:idle
      {taskId}
      {challenge}
      offeringKey={offering.offeringKey}
    />
  </CourseInteraction>
</section>
