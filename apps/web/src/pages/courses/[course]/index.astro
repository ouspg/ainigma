---
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LearningFrame from "../../../components/shell/LearningFrame.astro";
import CourseOverview from "../../../components/pages/CourseOverview";
import { getLearningPageData } from "../../../lib/learning/catalog";
import { getPublishedCourseEntry } from "../../../lib/learning/content-entry";
import { getLocale } from "../../../lib/i18n";
import { courseSlugFromParam } from "../../../lib/learning/identifiers";

export const prerender = false;

const courseSlug = courseSlugFromParam(Astro.params.course);
if (!courseSlug) {
  return new Response("Not found", { status: 404 });
}
const entry = await getPublishedCourseEntry(courseSlug);
if (!entry || entry.data.kind !== "course") {
  return new Response("Not found", { status: 404 });
}
const { Content } = await render(entry);
const { course, workspace } = await getLearningPageData(Astro.locals.profile!, courseSlug);
const locale = getLocale(Astro.currentLocale);
---

<BaseLayout title={`${course.title} | Ainigma`} description={course.summary} {locale}>
  <LearningFrame
    currentPath={course.href}
    courses={workspace.courses}
    profile={workspace.profile}
    term={workspace.term}
    activities={workspace.activity}
    {locale}
  >
    <CourseOverview {course} {locale}>
      <Content />
    </CourseOverview>
  </LearningFrame>
</BaseLayout>
