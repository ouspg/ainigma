---
import { getCollection } from "astro:content";
import CourseUpdatesList from "../../components/pages/CourseUpdatesList";
import HistoryPageLayout from "../../components/pages/HistoryPageLayout";
import LearningFrame from "../../components/shell/LearningFrame.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLocale, getMessages } from "../../lib/i18n";
import { getLearningWorkspace } from "../../lib/learning/catalog";

const entries = await getCollection("courses");
const workspace = await getLearningWorkspace(entries);
const locale = getLocale(Astro.currentLocale);
const copy = getMessages(locale);
---

<BaseLayout
  title={`${copy.navigation.announcements} | Ainigma`}
  description={copy.dashboard.activeCoursesSource}
  {locale}
>
  <LearningFrame
    currentPath="/announcements/"
    courses={workspace.courses}
    profile={workspace.profile}
    term={workspace.term}
    activities={workspace.activity}
    {locale}
  >
    <HistoryPageLayout
      title={copy.navigation.announcements}
      description={copy.dashboard.activeCoursesSource}
    >
      <CourseUpdatesList announcements={workspace.announcements} courses={workspace.courses} {locale} />
    </HistoryPageLayout>
  </LearningFrame>
</BaseLayout>
