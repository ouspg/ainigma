# Finnish remains hidden until the learner instructions have Finnish versions.
PUBLIC_FEATURE_FINNISH=false

# Set to `local` to show the seeded-user picker on the login page during local development.
PUBLIC_AUTH_MODE=github

# `supabase status --output env` prints the local API URL and publishable/anon key.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_local_publishable_key

# Server-only local Auth Admin key. Use the local secret/service-role key from `supabase status`.
# Never prefix this with PUBLIC_ and never use it outside local development.
SUPABASE_SECRET_KEY=replace_with_local_secret_key
