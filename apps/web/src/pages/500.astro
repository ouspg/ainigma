---
import ErrorPage from "../components/pages/ErrorPage";
import SiteFooter from "../components/layout/SiteFooter.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLocale, getMessages } from "../lib/i18n";

Astro.response.status = 500;
const locale = getLocale(Astro.currentLocale);
const title = getMessages(locale).errors.serverErrorTitle;
---

<BaseLayout title={`${title} | Ainigma`} description={title} {locale}>
  <ErrorPage status={500} {locale} />
  <div class="public-footer-frame">
    <SiteFooter {locale} />
  </div>
</BaseLayout>
