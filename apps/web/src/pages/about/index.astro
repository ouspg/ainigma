---
import PublicInfoPage from "../../components/pages/PublicInfoPage.astro";
import PublicLayout from "../../components/layout/PublicLayout.astro";
import { getLocale, getMessages } from "../../lib/i18n";
import { routes } from "../../lib/routes";

const locale = getLocale(Astro.currentLocale);
const metadata = getMessages(locale).metadata;
---

<PublicLayout
  title={metadata.aboutTitle}
  description={metadata.aboutDescription}
  currentPath={routes.about.path()}
  {locale}
>
  <PublicInfoPage kind="about" {locale} />
</PublicLayout>
