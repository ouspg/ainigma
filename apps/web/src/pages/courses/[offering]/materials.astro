---
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LearningFrame from "../../../components/shell/LearningFrame.astro";
import ReadingWorkspace from "../../../components/pages/ReadingWorkspace";
import {
  buildOutlineSections,
  getLearningPageData,
} from "../../../lib/learning/catalog";
import { getPublishedCourseEntry } from "../../../lib/learning/content-entry";
import { getLocale } from "../../../lib/i18n";
import { courseOfferingKeyFromParam } from "../../../lib/learning/identifiers";
import { routes } from "../../../lib/routes";

export const prerender = false;

const offeringKey = courseOfferingKeyFromParam(Astro.params.offering);
const authorizedCourseDefinitionKey = Astro.locals.authorizedCourseOffering?.courseDefinitionKey;
const authorizedCourseDefinitionReleaseId =
  Astro.locals.authorizedCourseOffering?.courseDefinitionReleaseId;
if (!offeringKey || !authorizedCourseDefinitionKey || !authorizedCourseDefinitionReleaseId) {
  return new Response("Not found", { status: 404 });
}
const { course, workspace } = await getLearningPageData(
  Astro.locals.profile!,
  offeringKey,
  authorizedCourseDefinitionKey,
  authorizedCourseDefinitionReleaseId,
);
const entry = await getPublishedCourseEntry(`${course.courseDefinitionSlug}/materials`);
if (!entry || entry.data.kind !== "course-page" || entry.data.page !== "materials") {
  return new Response("Not found", { status: 404 });
}
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const outline = buildOutlineSections(headings, remarkPluginFrontmatter.activityOutline);
const currentPath = routes.coursePage.path({ offeringKey: course.offeringKey, page: "materials" });
const locale = getLocale(Astro.currentLocale);
---

<BaseLayout title={`${entry.data.title} | ${course.title}`} description={entry.data.summary} {locale}>
  <LearningFrame
    {currentPath}
    courses={workspace.courses}
    profile={workspace.profile}
    term={workspace.term}
    activities={workspace.activity}
    {locale}
  >
    <ReadingWorkspace
      eyebrow={`${course.code} · Course resources`}
      title={entry.data.title}
      summary={entry.data.summary}
      {locale}
      {outline}
      previous={{ href: course.href, label: "Course overview" }}
    >
      <Content />
    </ReadingWorkspace>
  </LearningFrame>
</BaseLayout>
