---
import { render } from "astro:content";
import LearningLayout from "../../../components/layout/LearningLayout.astro";
import CourseOverview from "../../../components/pages/CourseOverview.astro";
import { getPublishedCourseEntry } from "../../../lib/learning/content-entry";
import { getLocale } from "../../../lib/i18n";
import { loadCoursePageData } from "../../../lib/learning/page-data";

export const prerender = false;

const page = await loadCoursePageData(Astro.locals);
if (!page) return new Response("Not found", { status: 404 });
const { accessState, course } = page;
const entry = await getPublishedCourseEntry(course.courseDefinitionSlug);
if (!entry || entry.data.kind !== "course") {
  return new Response("Not found", { status: 404 });
}
const { Content } = await render(entry);
const locale = getLocale(Astro.currentLocale);
---

<LearningLayout
  title={`${course.title} | Ainigma`}
  description={course.summary}
  currentPath={course.href}
  frame={page}
  {locale}
>
  <CourseOverview {course} {accessState} {locale}>
    <Content />
  </CourseOverview>
</LearningLayout>
