---
import { render } from "astro:content";
import CourseReadingLayout from "../../../components/layout/CourseReadingLayout.astro";
import { buildOutlineSections } from "../../../lib/learning/catalog";
import { getPublishedCourseEntry } from "../../../lib/learning/content-entry";
import { getLocale } from "../../../lib/i18n";
import { loadCoursePageData } from "../../../lib/learning/page-data";
import { routes } from "../../../lib/routes";

export const prerender = false;

const page = await loadCoursePageData(Astro.locals);
if (!page) return new Response("Not found", { status: 404 });
const { course } = page;
const entry = await getPublishedCourseEntry(`${course.courseDefinitionSlug}/announcements`);
if (!entry || entry.data.kind !== "course-page" || entry.data.page !== "announcements") {
  return new Response("Not found", { status: 404 });
}
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const outline = buildOutlineSections(headings, remarkPluginFrontmatter.activityOutline);
const currentPath = routes.coursePage.path({ offeringKey: course.offeringKey, page: "announcements" });
const locale = getLocale(Astro.currentLocale);
---

<CourseReadingLayout
  eyebrow={`${course.code} · Course updates`}
  title={entry.data.title}
  summary={entry.data.summary}
  {currentPath}
  {locale}
  {outline}
  {page}
  previous={{ href: course.href, label: "Course overview" }}
>
  <Content />
</CourseReadingLayout>
