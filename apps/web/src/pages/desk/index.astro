---
import LearningLayout from "../../components/layout/LearningLayout.astro";
import Dashboard from "../../components/pages/Dashboard.astro";
import { getLocale, getMessages } from "../../lib/i18n";
import { loadLearningShellData } from "../../lib/learning/page-data";
import { routes } from "../../lib/routes";

export const prerender = false;

const shell = await loadLearningShellData(Astro.locals);
const { workspace } = shell;
const locale = getLocale(Astro.currentLocale);
const metadata = getMessages(locale).metadata;
---

<LearningLayout
  title={metadata.deskTitle}
  description={metadata.deskDescription}
  currentPath={routes.desk.path()}
  frame={shell}
  {locale}
>
  <Dashboard
    availableCourses={shell.availableCourses}
    {workspace}
    {locale}
  />
</LearningLayout>
