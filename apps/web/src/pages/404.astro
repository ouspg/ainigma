---
import ErrorPage from "../components/pages/ErrorPage.astro";
import PublicLayout from "../components/layout/PublicLayout.astro";
import { getLocale, getMessages } from "../lib/i18n";
import { routes } from "../lib/routes";

Astro.response.status = 404;
const locale = getLocale(Astro.currentLocale);
const title = getMessages(locale).errors.notFoundTitle;
---

<PublicLayout
  title={`${title} | Ainigma`}
  description={title}
  currentPath={routes.status.path({ code: "404" })}
  {locale}
>
  <ErrorPage status={404} {locale} />
</PublicLayout>
