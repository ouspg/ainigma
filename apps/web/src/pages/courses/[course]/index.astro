---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LearningFrame from "../../../components/shell/LearningFrame.astro";
import CourseOverview from "../../../components/pages/CourseOverview";
import {
  getCourse,
  getLearningWorkspace,
  getPublishedCourseEntry,
} from "../../../lib/learning/catalog";
import { getLocale } from "../../../lib/i18n";
import { courseDefinitionKeyFromParam } from "../../../lib/learning/identifiers";

export const prerender = false;

const entries = await getCollection("courses");
const courseSlug = courseDefinitionKeyFromParam(Astro.params.course);
if (!courseSlug) {
  return new Response("Not found", { status: 404 });
}
const entry = getPublishedCourseEntry(entries, `${courseSlug}/index`);
if (!entry || entry.data.kind !== "course") {
  return new Response("Not found", { status: 404 });
}
const { Content } = await render(entry);
const workspace = await getLearningWorkspace(entries, Astro.locals.profile);
const course = await getCourse(entries, courseSlug);
const locale = getLocale(Astro.currentLocale);
---

<BaseLayout title={`${course.title} | Ainigma`} description={course.summary} {locale}>
  <LearningFrame
    currentPath={course.href}
    courses={workspace.courses}
    profile={workspace.profile}
    term={workspace.term}
    activities={workspace.activity}
    {locale}
  >
    <CourseOverview {course} {locale}>
      <Content />
    </CourseOverview>
  </LearningFrame>
</BaseLayout>
