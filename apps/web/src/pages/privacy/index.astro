---
import PublicInfoPage from "../../components/pages/PublicInfoPage.astro";
import PublicLayout from "../../components/layout/PublicLayout.astro";
import PrivacyPolicy from "../../content/legal/privacy-policy.en.mdx";
import { getLocale, getMessages } from "../../lib/i18n";
import { routes } from "../../lib/routes";

const locale = getLocale(Astro.currentLocale);
const metadata = getMessages(locale).metadata;
---

<PublicLayout
  title={metadata.privacyTitle}
  description={metadata.privacyDescription}
  currentPath={routes.privacy.path()}
  {locale}
>
  <PublicInfoPage kind="privacy" {locale}>
    <PrivacyPolicy />
  </PublicInfoPage>
</PublicLayout>
