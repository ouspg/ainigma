---
import ActivityHistory from "../../components/pages/ActivityHistory.astro";
import LearningLayout from "../../components/layout/LearningLayout.astro";
import { getLocale, getMessages } from "../../lib/i18n";
import { loadLearningShellData } from "../../lib/learning/page-data";
import { routes } from "../../lib/routes";

export const prerender = false;

const shell = await loadLearningShellData(Astro.locals);
const { workspace } = shell;
const locale = getLocale(Astro.currentLocale);
const metadata = getMessages(locale).metadata;
---

<LearningLayout
  title={metadata.activityTitle}
  description={metadata.activityDescription}
  currentPath={routes.activity.path()}
  frame={shell}
  {locale}
>
  <ActivityHistory activities={workspace.activity} courses={workspace.courses} {locale} />
</LearningLayout>
