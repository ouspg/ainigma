---
import { Button } from "@astryxdesign/core/Button";
import { Card } from "@astryxdesign/core/Card";
import { VStack } from "@astryxdesign/core/Stack";
import { Heading, Text } from "@astryxdesign/core/Text";
import type { LocalAuthPersonaOption } from "./dev-local-auth";
import { getMessages, type Locale } from "../lib/i18n";
import { routes, type AppPath } from "../lib/routes";

interface Props {
  locale: Locale;
  next: AppPath;
  personas: readonly LocalAuthPersonaOption[];
}

const { locale, next, personas } = Astro.props;
const copy = getMessages(locale).login;

const localAuthHref = (persona: LocalAuthPersonaOption["key"]): string => {
  const localAuthUrl = new URL(routes.authLocal.path(), "https://ainigma.invalid");
  localAuthUrl.searchParams.set("next", next);
  localAuthUrl.searchParams.set("persona", persona);
  return `${localAuthUrl.pathname}${localAuthUrl.search}`;
};
---

<Card padding={6}>
  <VStack gap={3}>
    <VStack gap={1}>
      <Heading level={2}>{copy.localTitle}</Heading>
      <Text type="supporting" color="secondary">
        {copy.localDescription}
      </Text>
    </VStack>
    {personas.map((persona) => (
      <VStack gap={1}>
        <Button
          href={localAuthHref(persona.key)}
          label={persona.label}
          size="md"
          variant="secondary"
          width="100%"
        />
        <Text type="supporting" color="secondary">
          {persona.description}
        </Text>
      </VStack>
    ))}
    <Text type="supporting" color="secondary">
      {copy.localNote}
    </Text>
  </VStack>
</Card>
