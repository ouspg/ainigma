---
import DocsLayout from "../layouts/DocsLayout.astro";
import {
  getDocsStaticPaths,
  getDocsPageProps,
  getRouteFlags,
  getSidebar,
  getPrevNext,
  getBreadcrumbs,
  getEditUrl,
  getLastUpdated,
  getTOC,
} from "@cloudflare/nimbus-docs";
import { components } from "../components";
import type { GetStaticPaths } from "astro";
import { docsVersions, withDocsBase, withoutDocsBase } from "../../config/versions.mjs";
import { docsSites } from "../../config/sites.mjs";
import { prefixNavigationItems, prefixPrevNext } from "../lib/versioned-navigation.mjs";

export const prerender = true;
export const getStaticPaths: GetStaticPaths = async (options) => {
  return (await getDocsStaticPaths(options)).map((route) => ({
    ...route,
    params: {
      slug: route.params.slug === "index" ? undefined : route.params.slug,
    },
  }));
};

const { entry, Content, headings } = await getDocsPageProps(Astro);

const currentSlug =
  withoutDocsBase(Astro.url.pathname, docsVersions.current.base).replace(/\/$/, "") || "/";

const { sidebar: sidebarOn, tableOfContents: tocOn } = await getRouteFlags(entry);

const rawSidebar = sidebarOn
  ? await getSidebar(currentSlug, { collection: entry.collection })
  : false;
// Nimbus cannot infer a section for root-level pages, so its section scope
// falls back to the full tree. Keep those pages on the explicit root rail;
// product pages continue to receive their directory-scoped group.
const isRootPage = !docsSites.some(
  ({ slug }) => currentSlug === `/${slug}` || currentSlug.startsWith(`/${slug}/`),
);
const rootSidebar = rawSidebar !== false && isRootPage
  ? rawSidebar.filter((item) => item.type === "link")
  : rawSidebar;
const rawPrevNext = await getPrevNext(currentSlug, {
  sidebarTree: rootSidebar === false ? [] : rootSidebar,
  overrides: { prev: entry.data.prev, next: entry.data.next },
});
const sidebar = rootSidebar === false
  ? false
  : prefixNavigationItems(rootSidebar, docsVersions.current.base);
const prevNext = prefixPrevNext(rawPrevNext, docsVersions.current.base);
// Pass `collection` so versioned pages (docs-<v>) get version-prefixed
// breadcrumb hrefs — parity with the getSidebar call above.
const breadcrumbs = prefixNavigationItems(
  await getBreadcrumbs(currentSlug, { collection: entry.collection }),
  docsVersions.current.base,
);
const editUrl = await getEditUrl(entry);
// Frontmatter wins; git is the fallback.
const lastUpdated = entry.data.lastUpdated ?? await getLastUpdated(entry);
// `tocOn` already implies `tableOfContents !== false`, but TS can't carry
// that boolean narrowing to the value here — re-check it so `getTOC` only
// ever sees its options object (or undefined), never `false`.
const tocConfig = entry.data.tableOfContents;
const toc = tocOn && tocConfig !== false ? getTOC(headings, tocConfig) : false;
const markdownPath = withDocsBase(
  entry.id === "index" ? "/index.md" : `/${entry.id}/index.md`,
  docsVersions.current.base,
);
const markdownUrl = Astro.site ? new URL(markdownPath, Astro.site).href : markdownPath;
const socialImage = entry.data.socialImage
  ? withDocsBase(entry.data.socialImage, docsVersions.current.base)
  : undefined;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  headings={toc}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
  mode={entry.data.mode}
  banner={entry.data.banner}
  head={entry.data.head}
  searchable={entry.data.searchable}
  noindex={entry.data.noindex}
  markdownUrl={markdownUrl}
  socialImage={socialImage}
  lastUpdated={lastUpdated}
  editUrl={editUrl}
  draft={entry.data.draft}
  audience={entry.data.audience}
  collection={entry.collection}
  entryId={entry.id}
>
  <Content components={components} />
</DocsLayout>
