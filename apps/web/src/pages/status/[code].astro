---
import ErrorPage, { type ErrorStatus } from "../../components/pages/ErrorPage.astro";
import PublicLayout from "../../components/layout/PublicLayout.astro";
import { getLocale, getMessages } from "../../lib/i18n";
import { routes } from "../../lib/routes";

export const prerender = false;

const code = Astro.params.code;
const status: ErrorStatus =
  code === "403" ? 403 : code === "500" ? 500 : code === "503" ? 503 : 404;
Astro.response.status = status;
const locale = getLocale(Astro.currentLocale);
const messages = getMessages(locale);
const title =
  status === 403
    ? messages.errors.accessDeniedTitle
    : status === 500
      ? messages.errors.serverErrorTitle
    : status === 503
      ? messages.errors.unavailableTitle
      : messages.errors.notFoundTitle;
---

<PublicLayout
  title={`${title} | Ainigma`}
  description={title}
  currentPath={routes.status.path({ code: String(status) })}
  {locale}
>
  <ErrorPage {status} {locale} />
</PublicLayout>
