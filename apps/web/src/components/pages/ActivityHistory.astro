---
import { List, ListItem } from "@astryxdesign/core/List";
import { HStack, VStack } from "@astryxdesign/core/Stack";
import { Text } from "@astryxdesign/core/Text";
import { CheckCircle2, ChevronRight, ClipboardCheck, Download, Server } from "lucide-react";
import { getMessages, type Locale } from "../../lib/i18n";
import type { CourseInfo, LearnerActivity } from "../../lib/learning/types";
import { localizedPath } from "../../lib/routes";
import HistoryPageLayout from "./HistoryPageLayout.astro";

interface Props {
  activities: LearnerActivity[];
  courses: CourseInfo[];
  locale: Locale;
}

const activityIcons = {
  attempt: CheckCircle2,
  grading: ClipboardCheck,
  artifact: Download,
  instance: Server,
} as const;

const { activities, courses, locale } = Astro.props;
const copy = getMessages(locale).activity;
const courseByOfferingKey = new Map(courses.map((course) => [course.offeringKey, course]));
---

<HistoryPageLayout title={copy.historyTitle} description={copy.historyDescription}>
  <List className="activity-history-list" density="spacious" hasDividers>
    <Text slot="header" className="visually-hidden">{copy.eventList}</Text>
    {activities.map((activity) => {
      const ActivityIcon = activityIcons[activity.kind];
      const course = courseByOfferingKey.get(activity.offeringKey);
      return (
        <ListItem href={localizedPath(locale, activity.href)} label={activity.title}>
          <VStack slot="description" gap={1}>
            <Text type="body" color="secondary">
              {activity.description}
            </Text>
            <Text type="supporting" color="secondary">
              {course?.code} · {course?.title}
            </Text>
            <Text
              className="activity-history-mobile-meta"
              type="supporting"
              color="secondary"
            >
              {copy.kind[activity.kind]} ·{" "}
              <time datetime={activity.occurredAt}>{activity.timeLabel}</time>
            </Text>
          </VStack>
          <HStack slot="endContent" className="activity-history-meta" gap={3} vAlign="center">
            <VStack gap={0.5} hAlign="end">
              <Text type="supporting" weight="medium">
                {copy.kind[activity.kind]}
              </Text>
              <Text type="supporting" color="secondary">
                <time datetime={activity.occurredAt}>{activity.timeLabel}</time>
              </Text>
            </VStack>
            <ChevronRight size={17} aria-hidden="true" />
          </HStack>
          <Text slot="label" type="large" weight="semibold">
            {activity.title}
          </Text>
          <span slot="startContent" class={`activity-kind-icon history kind-${activity.kind}`}>
            <ActivityIcon size={18} aria-hidden="true" />
          </span>
        </ListItem>
      );
    })}
  </List>
</HistoryPageLayout>
