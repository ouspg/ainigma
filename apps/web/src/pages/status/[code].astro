---
import ErrorPage, { type ErrorStatus } from "../../components/pages/ErrorPage";
import SiteFooter from "../../components/layout/SiteFooter.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLocale, getMessages } from "../../lib/i18n";

export const prerender = false;

const code = Astro.params.code;
const status: ErrorStatus =
  code === "403" ? 403 : code === "500" ? 500 : code === "503" ? 503 : 404;
Astro.response.status = status;
const locale = getLocale(Astro.currentLocale);
const messages = getMessages(locale);
const title =
  status === 403
    ? messages.errors.accessDeniedTitle
    : status === 500
      ? messages.errors.serverErrorTitle
    : status === 503
      ? messages.errors.unavailableTitle
      : messages.errors.notFoundTitle;
---

<BaseLayout title={`${title} | Ainigma`} description={title} {locale}>
  <ErrorPage {status} {locale} />
  <div class="public-footer-frame">
    <SiteFooter {locale} />
  </div>
</BaseLayout>
