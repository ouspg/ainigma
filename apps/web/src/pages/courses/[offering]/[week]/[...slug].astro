---
import { render } from "astro:content";
import CourseReadingLayout from "../../../../components/layout/CourseReadingLayout.astro";
import { buildOutlineSections } from "../../../../lib/learning/catalog";
import { getPublishedCourseEntry } from "../../../../lib/learning/content-entry";
import { getLocale } from "../../../../lib/i18n";
import { loadCoursePageData } from "../../../../lib/learning/page-data";

export const prerender = false;

const weekSlug = Astro.params.week ?? "";
const taskSlug = Astro.params.slug ?? "";
const page = await loadCoursePageData(Astro.locals);
if (!page) return new Response("Not found", { status: 404 });
const { course } = page;
const entry = await getPublishedCourseEntry(
  `${course.courseDefinitionSlug}/${weekSlug}/${taskSlug}`,
);
if (!entry || entry.data.kind !== "task") {
  return new Response("Not found", { status: 404 });
}
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const week = course.weeks.find((candidate) => candidate.slug === weekSlug);
if (!week) throw new Error(`Missing week manifest for task: ${entry.id}`);
const taskIndex = week.tasks.findIndex((task) => entry.id.endsWith(`/${task.slug}`));
const previousTask = taskIndex > 0 ? week.tasks[taskIndex - 1] : undefined;
const nextTask = taskIndex >= 0 ? week.tasks[taskIndex + 1] : undefined;
const outline = buildOutlineSections(headings, remarkPluginFrontmatter.activityOutline);
const currentPath = week.tasks[taskIndex]?.href ?? week.href;
const locale = getLocale(Astro.currentLocale);
---

<CourseReadingLayout
  eyebrow={`${course.code} · Week ${week.number} · Activity ${taskIndex + 1}`}
  title={entry.data.title}
  summary={entry.data.summary}
  {currentPath}
  {locale}
  meta={[`${entry.data.estimatedMinutes} minutes`, `${entry.data.points} points`]}
  {outline}
  {page}
  previous={
    previousTask
      ? { href: previousTask.href, label: previousTask.title }
      : { href: week.href, label: `Week ${week.number} overview` }
  }
  {...(nextTask ? { next: { href: nextTask.href, label: nextTask.title } } : {})}
>
  <Content />
</CourseReadingLayout>
