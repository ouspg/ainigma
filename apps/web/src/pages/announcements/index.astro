---
import CourseUpdatesList from "../../components/pages/CourseUpdatesList.astro";
import HistoryPageLayout from "../../components/pages/HistoryPageLayout.astro";
import LearningLayout from "../../components/layout/LearningLayout.astro";
import { getLocale, getMessages } from "../../lib/i18n";
import { loadLearningShellData } from "../../lib/learning/page-data";
import { routes } from "../../lib/routes";

export const prerender = false;

const shell = await loadLearningShellData(Astro.locals);
const { workspace } = shell;
const locale = getLocale(Astro.currentLocale);
const copy = getMessages(locale);
---

<LearningLayout
  title={`${copy.navigation.announcements} | Ainigma`}
  description={copy.dashboard.activeCoursesSource}
  currentPath={routes.announcements.path()}
  frame={shell}
  {locale}
>
  <HistoryPageLayout
    title={copy.navigation.announcements}
    description={copy.dashboard.activeCoursesSource}
  >
    <CourseUpdatesList
      announcements={workspace.announcements}
      courses={workspace.courses}
      {locale}
    />
  </HistoryPageLayout>
</LearningLayout>
