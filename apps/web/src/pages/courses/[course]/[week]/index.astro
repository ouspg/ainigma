---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import LearningFrame from "../../../../components/shell/LearningFrame.astro";
import ReadingWorkspace from "../../../../components/pages/ReadingWorkspace";
import {
  buildOutlineSections,
  getCourse,
  getLearningWorkspace,
} from "../../../../lib/learning/catalog";
import { getLocale } from "../../../../lib/i18n";

export async function getStaticPaths() {
  const entries = await getCollection("courses");
  const publishedCourses = new Set(
    entries.flatMap((entry) =>
      entry.data.kind === "course" && !entry.data.draft ? [entry.id.split("/")[0]] : [],
    ),
  );
  return entries
    .filter(
      (entry) =>
        entry.data.kind === "week" && publishedCourses.has(entry.id.split("/")[0] ?? ""),
    )
    .map((entry) => {
      const [course, week] = entry.id.split("/");
      return { params: { course, week }, props: { entry } };
    });
}

interface Props {
  entry: CollectionEntry<"courses">;
}

const { entry } = Astro.props;
if (entry.data.kind !== "week") throw new Error(`Expected week entry: ${entry.id}`);
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const entries = await getCollection("courses");
const workspace = await getLearningWorkspace(entries);
const course = await getCourse(entries, entry.id.split("/")[0] ?? "");
const week = course.weeks.find((candidate) => candidate.slug === entry.id.split("/")[1]);
if (!week) throw new Error(`Missing week manifest: ${entry.id}`);
const outline = buildOutlineSections(headings, remarkPluginFrontmatter.activityOutline);
const next = week.tasks[0]
  ? { href: week.tasks[0].href, label: `Start ${week.tasks[0].title}` }
  : undefined;
const locale = getLocale(Astro.currentLocale);
---

<BaseLayout title={`${entry.data.title} | ${course.title}`} description={entry.data.summary} {locale}>
  <LearningFrame
    currentPath={week.href}
    courses={workspace.courses}
    profile={workspace.profile}
    term={workspace.term}
    activities={workspace.activity}
    {locale}
  >
    <ReadingWorkspace
      eyebrow={`${course.code} · Week ${entry.data.weekNumber}`}
      title={entry.data.title}
      summary={entry.data.summary}
      {locale}
      meta={[`${week.tasks.length} ${week.tasks.length === 1 ? "activity" : "activities"}`]}
      {outline}
      previous={{ href: course.href, label: "Course overview" }}
      {...(next ? { next } : {})}
    >
      <Content />
    </ReadingWorkspace>
  </LearningFrame>
</BaseLayout>
